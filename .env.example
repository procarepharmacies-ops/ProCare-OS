# ProCare OS — example environment file.
# Copy to `.env` (git-ignored) and fill in as needed. All keys are OPTIONAL:
# the stack runs seeded/offline with none of them set.

# --- Firecrawl CLI (web scraping) -------------------------------------------
# Alternative to `firecrawl login`; see docs/09-firecrawl-cli.md.
# FIRECRAWL_API_KEY=fc-xxxxxxxx
# FIRECRAWL_API_URL=            # only for a self-hosted Firecrawl instance
# FIRECRAWL_NO_TELEMETRY=1      # opt out of Firecrawl usage telemetry

# --- AI assistant (both defaults are FREE tiers) -----------------------------
# Pick ONE provider. With no key at all the assistant still works, using its
# offline keyword router (no LLM).
#
# 1) Gemini Pro — free tier at https://aistudio.google.com/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
#
# 2) Hermes (Nous Research) via OpenRouter free models — get a key at
#    https://openrouter.ai/keys. Same key the branch PCs' Hermes Agent uses
#    (docs/ESTOCK_MIRROR_ON_BRANCHES.md), so one key covers both.
# AI_PROVIDER=hermes
# OPENROUTER_API_KEY=sk-or-v1-...
#
# 3) Claude API (paid)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
#
# 4) Hermes CLI — a Hermes binary installed & logged in ON THIS PC. ProCare
#    holds no key; the binary carries its own auth. NOT the same as (2): that
#    one posts to OpenRouter, this one shells out locally.
# AI_PROVIDER=hermes-cli
# HERMES_CLI_BIN=hermes        # default: hermes (use a full path if not on PATH)
# HERMES_CLI_ARGS=-p           # default: -p   (args BEFORE the prompt)
#
# 5) Claude Code CLI — same arrangement, local `claude` binary, no key.
# AI_PROVIDER=claude-cli
# CLAUDE_CLI_BIN=claude
# CLAUDE_CLI_ARGS=-p
#
# Leave AI_MODEL unset to take the provider's free-tier default
# (gemini -> gemini-2.5-pro, hermes -> a Nous Hermes :free slug).
# AI_MODEL=
# AI_MODEL_FALLBACKS=          # comma-separated, tried when the primary 429s
# AI_BASE_URL=                 # only for ollama / a self-hosted gateway

# --- eStock continuous sync --------------------------------------------------
# SYNC_ENABLED=0               # 1 = mirror the real eStock DB in the background
# SYNC_INTERVAL_SECONDS=30

# --- Automation / operations (scheduler) ------------------------------------
# AUTOMATION_ENABLED=0         # 1 = run scheduled jobs (digest, db-health, …)
#                              # Also enables: shift reminders, weekly schedule broadcast,
#                              #              Um Adham daily checklist, CEO 8am digest
# BRANCH_TIMEZONE=             # IANA name, e.g. Africa/Cairo (UTC+2)
#                              # Used for all cron jobs (9pm shift reminder, 8am digest, etc.)
# DB_SIZE_CAP_MB=10240         # SQL Server Express 10 GB cap for db-health alerts

# --- WhatsApp automation (Meta Cloud API) ------------------------------------
# For weekly schedule distribution, staff reminders, and manager alerts:
#
# Option A: Direct WhatsApp Cloud API (recommended for production)
# WHATSAPP_TOKEN=              # Meta Business access token (from Business Manager)
# WHATSAPP_PHONE_ID=           # Phone number ID for sending messages
# MANAGER_PHONE=+20101234567   # Manager phone for alerts (international format)
#
# Option B: Click-to-Chat fallback (works without credentials)
# Leave WHATSAPP_TOKEN/PHONE_ID empty; system generates wa.me/ links
# Staff can click to open WhatsApp with pre-filled messages
#
# Configured schedules (when AUTOMATION_ENABLED=1):
# - Daily 9:00 PM    (BRANCH_TIMEZONE): Tomorrow's shift reminder
# - Saturday 8:00 AM (BRANCH_TIMEZONE): Full weekly schedule broadcast
# - Daily 10:00 AM (Sat-Thu, BRANCH_TIMEZONE): Um Adham cleaning checklist
